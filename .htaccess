RewriteEngine On

# Если IP НЕ равен вашему, то сервер выдаст ошибку 403 Forbidden
RewriteCond %{REMOTE_ADDR} !^194\.186\.175\.161$

# (Опционально) Если у вас есть второй IP, раскомментируйте строку ниже:
RewriteCond %{REMOTE_ADDR} !^37\.98\.244\.138$
RewriteCond %{REMOTE_ADDR} !^92\.248\.188\.173$
RewriteCond %{REMOTE_ADDR} !^81\.222\.184\.226$

RewriteRule ^ - [F,L]
