rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'shkololoshka.invictiv@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: UserAccount
    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid',
          'login',
          'displayName',
          'role',
          'allowedSections',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'login',
          'displayName',
          'role',
          'allowedSections',
          'active',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.login is string && data.login.size() >= 2 && data.login.size() <= 100 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role is string && data.role.size() <= 20 && (data.role == 'admin' || data.role == 'user') &&
        data.allowedSections is list && data.allowedSections.size() <= 25 &&
        (data.allowedSections.size() == 0 || (data.allowedSections[0] is string && data.allowedSections[0].size() >= 1 && data.allowedSections[0].size() <= 50)) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: AdminMarker
    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        userId == request.auth.uid ||
        existing().uid == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            userId == request.auth.uid &&
            incoming().uid == request.auth.uid &&
            incoming().role == 'user' &&
            incoming().active == true
          )
        );

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserAccount(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            userId == request.auth.uid &&
            existing().uid == request.auth.uid &&
            incoming().uid == existing().uid &&
            incoming().role == existing().role &&
            incoming().allowedSections == existing().allowedSections &&
            incoming().active == existing().active &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedUser() && isValidId(userId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (
        adminId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        existing().uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isVerifiedUser() &&
        isValidId(adminId) &&
        isValidAdminMarker(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidId(adminId) &&
        isValidAdminMarker(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        isAdmin();

      allow delete: if isVerifiedUser() && isValidId(adminId) && isAdmin();
    }
  }
}
